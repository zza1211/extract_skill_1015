{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "term-extractor",
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-flash": {
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 65536
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
